# Telegram bot credentials (get a token from @BotFather, and your chat id from @userinfobot)
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
TELEGRAM_CHAT_ID=123456789

# A Yad2 search you want to monitor.
# Paste the normal search-page URL from your browser, e.g.:
#   https://www.yad2.co.il/realestate/forsale?city=5000&price=0-2000000&rooms=3-4
# The listener converts it to Yad2's feed API automatically.
YAD2_SEARCH_URL=https://www.yad2.co.il/realestate/forsale?city=5000

# --- Scraping API (required on a datacenter/VPS IP) -----------------------
# Yad2 is behind Radware Bot Manager, which blocks datacenter IPs. On a VPS you
# must fetch through a scraping API that provides a residential Israeli IP.
# Set your API key here; without it, the app falls back to a local browser
# (which only works from a residential IP).
YAD2_SCRAPER_API_KEY=
# Provider: scrapingbee (default) | zenrows | scraperapi
YAD2_SCRAPER=scrapingbee
# Residential proxy country (Israel).
YAD2_SCRAPER_COUNTRY=il
# Render JS at the provider? Usually off — we fetch the JSON gateway directly.
YAD2_SCRAPER_RENDER_JS=0

# How often to poll, in seconds (default 300 = 5 minutes)
POLL_INTERVAL=300

# Where to store the set of already-seen listing ids
STATE_FILE=state.json
